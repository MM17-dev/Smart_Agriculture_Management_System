<jasperReport name="Blank_A4" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="50a60efd-6434-415b-bcb9-02d0a97940f2">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="farmer_id" class="java.lang.Integer"/>
	<query language="sql"><![CDATA[SELECT
    o.order_id,
    u.name AS buyer_name,
    c.crop_name,
    h.quantity,
    o.order_date,
    o.status
FROM orders o
JOIN user_details u ON o.buyer_id = u.person_id
JOIN harvest h ON o.harvest_id = h.harvest_id
JOIN farmer_crop fc ON h.farmer_crop_id = fc.farmer_crop_id
JOIN crop c ON fc.crop_id = c.crop_id
WHERE fc.farmer_id = $P{farmer_id}
]]></query>
